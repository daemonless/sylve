# Sylve deployment settings. Save as .env next to compose.yaml, then edit.

# Hostname/FQDN you reach Sylve at. MUST match, or Sylve's node-identity check
# rejects requests (selected_node_not_found).
SYLVE_HOSTNAME=your-host.example.lan

# Host path where Sylve stores its data (DB + runtime config).
SYLVE_DATA_LOCATION=/containers/sylve/db

# ZFS dataset delegated to Sylve. Must match the dataset host-setup created
# (override there with SYLVE_DATASET=... when you run host-setup).
SYLVE_DATASET=zroot/sylve

# Timezone.
TZ=UTC
